# Generate a private random value of at least 32 characters; never commit the actual .env.
TRACE_DOCK_DEV=0
TOKEN_PEPPER=CHANGE_ME_WITH_A_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
DATABASE_URL=postgresql://trace_dock:CHANGE_ME@127.0.0.1:5432/trace_dock
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# Optional server-only read endpoint; on same-region ECS, use the OSS internal endpoint.
# OSS_READ_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_BUCKET=CHANGE_ME
OSS_ROLE_ARN=acs:ram::<account-id>:role/<role-name>
ALIYUN_REGION=cn-hangzhou
ALIYUN_ACCESS_KEY_ID=CHANGE_ME
ALIYUN_ACCESS_KEY_SECRET=CHANGE_ME
