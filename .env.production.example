# Copy to .env.production and replace all CHANGE_ME values.
# Compose reads this file in raw mode: do not wrap values in quotes.
TRACE_DOCK_DEV=0
DATABASE_URL=postgresql://trace_dock:CHANGE_ME_URL_ENCODED_PASSWORD@CHANGE_ME_RDS_PRIVATE_HOST:5432/trace_dock?sslmode=require
TOKEN_PEPPER=CHANGE_ME_WITH_ONE_STABLE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# Optional server-only read endpoint; on same-region ECS, use the OSS internal endpoint.
# OSS_READ_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_BUCKET=CHANGE_ME_PRIVATE_BUCKET
OSS_ROLE_ARN=acs:ram::CHANGE_ME_ACCOUNT:role/CHANGE_ME_ROLE
ALIYUN_REGION=cn-hangzhou
ALIYUN_ACCESS_KEY_ID=CHANGE_ME
ALIYUN_ACCESS_KEY_SECRET=CHANGE_ME
# Safe only with the supplied loopback port binding and a trusted reverse proxy.
FORWARDED_ALLOW_IPS=*
