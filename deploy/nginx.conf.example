# Install into Nginx's http context, e.g. /etc/nginx/conf.d/trace-dock.conf.
# Replace the domain and certificate paths before reloading Nginx.
server {
    listen 80;
    server_name collector.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name collector.example.com;

    ssl_certificate /etc/nginx/certs/collector.example.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/collector.example.com/privkey.pem;

    client_max_body_size 64k;
    access_log off;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 1900s;
        proxy_send_timeout 1900s;
        proxy_buffering off;
    }
}
